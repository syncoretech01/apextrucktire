# ---------------------------------------------------------------------------
# Apex Truck Tire — environment variables
# Copy to .env.local for local development. Never commit .env.local.
# Every value here is empty on purpose. See README.md for where to get each.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for canonical, OG, sitemap, and
# the CSRF origin check on the inquiry endpoint.
NEXT_PUBLIC_SITE_URL=

# --- Email (Resend) ---------------------------------------------------------
# https://resend.com/api-keys — restricted "Sending access" key is enough.
RESEND_API_KEY=
# Verified sender. Must be on a domain verified in Resend.
EMAIL_FROM=
# Where inquiry notifications go. Defaults to admin@apextrucktire.com.
EMAIL_TO=

# --- Rate limiting (Upstash Redis) -----------------------------------------
# https://console.upstash.com — create a Redis DB, copy the REST credentials.
# Production fails closed without these (submissions return 503).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile ---------------------------------------------------
# https://dash.cloudflare.com → Turnstile → widget type "Invisible".
# Leave both empty in development to use Cloudflare's always-pass test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- CSRF / form token signing ---------------------------------------------
# 32+ random bytes, e.g. `openssl rand -hex 32`. Required in production.
FORM_TOKEN_SECRET=

# --- Analytics (optional) ---------------------------------------------------
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Loaded only after consent.
NEXT_PUBLIC_GA4_ID=
# Google Ads conversion ID and labels, e.g. AW-123456789 and the label part
# after the slash. Leave empty to disable Ads conversion events.
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_LABEL_FORM=
NEXT_PUBLIC_GADS_LABEL_CALL=
